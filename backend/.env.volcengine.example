# 火山方舟模型配置片段。把这些项合并到原 backend/.env；不要覆盖 DATABASE_URL / API_KEY。
# 方舟标准 API，文字与图片共用一个具有对应模型权限的 Key；不是火山账号 AK/SK。
LLM_PROVIDER=volcengine
IMAGE_PROVIDER=volcengine
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_TEXT_MODEL=
ARK_IMAGE_MODEL=
# Model ID 或自定义推理接入点 Endpoint ID，须从控制台复制实际可用值。
LLM_SMALL_MODEL=
LLM_JSON_MODE=true
LLM_STREAMING=true
ARK_THINKING=disabled
# 旧模型若不接受 thinking 字段，可改为 omit。
ARK_IMAGE_SIZE=1728x2304
ARK_IMAGE_RESPONSE_FORMAT=b64_json
ARK_IMAGE_WATERMARK=true
IMAGE_CONCURRENCY=2
IMAGE_TIMEOUT_SECONDS=120
# 具体价格和额度以控制台为准；未设置单价时不估算费用。
# LLM_INPUT_PRICE_PER_MILLION=
# LLM_OUTPUT_PRICE_PER_MILLION=

# 可选：课程知识库启用火山向量模型。
# EMBEDDING_PROVIDER=volcengine
# ARK_EMBEDDING_MODEL=从控制台复制实际可用模型ID
# ARK_EMBEDDING_DIMENSIONS=1024
# EMBEDDING_PRICE_PER_MILLION=按当前模型实际单价填写
# 内容先在“课程素材库”建立索引，新任务才使用向量检索。
