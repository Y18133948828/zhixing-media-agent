# 推荐运行 python scripts/manage.py setup，由向导创建本地 .env。
# 公开版默认使用火山方舟真实文字与生图，调用由使用者自己的方舟账号付费。
DATABASE_URL=postgresql://media:change-me@127.0.0.1:5432/media_ops
# 多项目默认连接已安装的共享实例；项目不会启动或停止该实例。
DATABASE_MODE=shared
API_KEY=replace-with-a-long-random-key
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
STORAGE_DIR=storage
LLM_PROVIDER=volcengine
# 真实调用：LLM_PROVIDER=openai_compatible；BASE_URL 应以 /v1 结尾（或供应商的等效根路径）
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=your-model-name
LLM_SMALL_MODEL=
# 若供应商不支持 response_format，设为 false，仍会用 Pydantic 校验 JSON
LLM_JSON_MODE=true
LLM_STREAMING=true
# 若供应商不支持流式或 stream_options.include_usage，设 LLM_STREAMING=false。
# 单价按供应商当前实际报价填写，单位自定但输入/输出必须一致；留空则不估算费用。
# LLM_INPUT_PRICE_PER_MILLION=1.0
# LLM_OUTPUT_PRICE_PER_MILLION=4.0
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=6000
MAX_REVISIONS=10
WORKER_POLL_SECONDS=1
JOB_TIMEOUT_SECONDS=600
# 可选：不填时从本地随机 API_KEY 派生 JWT 签名密钥；填入长随机值后令牌会失效一次。
JWT_SECRET=
JWT_HOURS=12
REDACT_PII=true
# 公开版默认真实云生图；技术干货可自行切换 template 以保证中文/代码排版。
IMAGE_PROVIDER=volcengine
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_CONCURRENCY=2
IMAGE_TIMEOUT_SECONDS=120
# OpenAI 兼容生图：BASE_URL 为根路径，程序追加 /images/generations。
# IMAGE_SIZE 必须是供应商支持且能输出3:4的尺寸；不满足比例会报错。
IMAGE_SIZE=1536x2048
# Gemini：BASE_URL 为主机根地址，追加 /v1beta/models/{model}:generateContent。
# 代理通常用 bearer；需要 x-goog-api-key 请求头时改为该值。
IMAGE_AUTH=bearer
# Claude 原生接口：LLM_PROVIDER=anthropic，BASE_URL=https://api.anthropic.com/v1

# 火山方舟：真实调用时设置 LLM_PROVIDER=volcengine、IMAGE_PROVIDER=volcengine。
# 两个模型共用具有对应权限的 ARK_API_KEY；不使用上面的 LLM_API_KEY / IMAGE_API_KEY。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_TEXT_MODEL=
ARK_IMAGE_MODEL=
ARK_THINKING=disabled
ARK_IMAGE_SIZE=1728x2304
ARK_IMAGE_RESPONSE_FORMAT=b64_json
ARK_IMAGE_WATERMARK=true
# 完整配置片段见 .env.volcengine.example；开通与操作步骤见 docs/火山方舟接入指南.md。

# 可选能力默认关闭；Python 和 AI 服务仍在本地运行。
CHECKPOINTER_BACKEND=postgres
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5
DATABASE_BUSINESS_POOL=5
NODE_TIMEOUTS={"topics":300,"write_article":300,"summarize":180,"render_images":480,"wechat_format":30}
STAGE_TEMPERATURES={"TopicBatch":0.8,"Article":0.4,"CardPack":0.2}
STAGE_MAX_TOKENS={"TopicBatch":1800,"Article":4000,"CardPack":3000}
ROUTING_STRATEGY=stage
ROUTING_LATENCY_BUDGET_SECONDS=15
# ROUTING_COST_BUDGET=0.02
LLM_ATTEMPTS=3
LLM_CACHE_SECONDS=0
LLM_FALLBACK_PROVIDER=disabled
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
COST_CURRENCY=CNY
# IMAGE_PRICE_PER_IMAGE=填写控制台当前每张单价
RATE_LIMIT_PER_MINUTE=300
LOGIN_LIMIT_PER_MINUTE=10
LOG_DIR=logs

# 真正的向量RAG：disabled / volcengine / openai_compatible。
# 火山模式共用ARK_API_KEY，模型ID从自己的方舟控制台复制。
EMBEDDING_PROVIDER=disabled
ARK_EMBEDDING_MODEL=
# 支持该参数的模型可设置1024或2048；留为注释时省略参数。
# ARK_EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CONCURRENCY=4
# EMBEDDING_PRICE_PER_MILLION=

# 可选LangSmith。默认不向外部追踪平台发送内容。
TRACING_ENABLED=false
TRACING_INCLUDE_CONTENT=false
TRACING_API_KEY=
TRACING_ENDPOINT=https://api.smith.langchain.com
TRACING_PROJECT=media-demo

# 内容审查：本地禁用词规则 + 可选自有审查网关。
# 网关协议及原生云审查的边界见 docs/34项实现与验收.md。
CONTENT_BLOCKED_TERMS=[]
CONTENT_REVIEW_URL=
CONTENT_REVIEW_KEY=

# 可选企业OIDC单点登录；本地账号登录无需配置这些项。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/sso/callback
COOKIE_SECURE=false
